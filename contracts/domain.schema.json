{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "复合技能证据通行证领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "STANDARD_PUBLISHED",
        "JOB_REQUIREMENT_REGISTERED",
        "EVIDENCE_ACCEPTED",
        "PASSPORT_ISSUED",
        "SHARING_GRANTED",
        "ACCESS_REVOKED",
        "ACCESS_EXPIRED",
        "APPEAL_FILED",
        "APPEAL_DECIDED",
        "SNAPSHOT_TAKEN",
        "SNAPSHOT_DIFF_APPENDED",
        "RECORD_FROZEN"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "skill_standard",
        "evidence_item",
        "competency_passport",
        "job_requirement"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "STANDARD_PUBLISHED": [
      "standard_id",
      "standard_version",
      "units"
    ],
    "JOB_REQUIREMENT_REGISTERED": [
      "job_requirement_id",
      "employer_id",
      "standard_id",
      "required_units"
    ],
    "EVIDENCE_ACCEPTED": [
      "evidence_id",
      "standard_id",
      "standard_version",
      "student_id",
      "task_id",
      "observer_id",
      "supports_units",
      "authorization"
    ],
    "PASSPORT_ISSUED": [
      "student_id",
      "standard_id",
      "standard_version",
      "recipient_scope",
      "expires_at"
    ],
    "SHARING_GRANTED": [
      "passport_id",
      "recipient_id",
      "job_requirement_id",
      "expires_at"
    ],
    "ACCESS_REVOKED": [
      "passport_id",
      "recipient_id"
    ],
    "ACCESS_EXPIRED": [
      "passport_id",
      "recipient_id"
    ],
    "APPEAL_FILED": [
      "appeal_id",
      "passport_id",
      "affected_units",
      "reason"
    ],
    "APPEAL_DECIDED": [
      "appeal_id",
      "passport_id",
      "affected_units",
      "decision"
    ],
    "SNAPSHOT_TAKEN": [
      "snapshot_id",
      "passport_id",
      "recipient_id",
      "job_requirement_id",
      "basis_version",
      "conclusions"
    ],
    "SNAPSHOT_DIFF_APPENDED": [
      "snapshot_id",
      "passport_id",
      "cause",
      "changes"
    ],
    "RECORD_FROZEN": [
      "original_hash",
      "duplicate_hash",
      "reason"
    ]
  },
  "additionalProperties": false
}
